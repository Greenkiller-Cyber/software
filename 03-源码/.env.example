# 03-源码/.env.example
# 用法：cp .env.example .env 后按需修改，.env 禁止提交到仓库。
# docker compose 与后端启动都读这份配置（后端通过环境变量覆盖 application.yml 默认值）。

# ---- 项目 ----
PROJECT_NAME=fitmate

# ---- MySQL ----
DB_ROOT_PASSWORD=change-me-root
DB_NAME=fitmate
DB_USER=fitmate
DB_PASSWORD=change-me
DB_PORT=3306

# ---- Redis ----
REDIS_PORT=6379

# ---- RabbitMQ（启用 C3 异步场景时打开 docker-compose 中对应注释）----
MQ_USER=fitmate
MQ_PASSWORD=change-me-mq

# ---- 后端（与 application.yml 的 ${DB_*} 占位对应）----
# 直接用 compose 起的库时保持默认即可；连外部库时改这里
DB_URL=jdbc:mysql://localhost:3306/fitmate?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=fitmate
DB_PASSWORD=change-me
SERVER_PORT=8080